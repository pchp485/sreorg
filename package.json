{
  "name": "sreorg",
  "version": "0.2.0",
  "private": true,
  "description": "A portfolio of small Indian-compliance SaaS products sharing one billing, automation and growth engine.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "portfolio": "tsx scripts/portfolio-report.ts",
    "growth": "tsx scripts/growth-engine.ts",
    "dunning": "tsx apps/invoicing/scripts/dunning-engine.ts",
    "payroll:run": "tsx apps/payroll/scripts/payroll-engine.ts",
    "compliance:run": "tsx apps/compliance/scripts/reminder-engine.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
