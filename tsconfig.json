{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@sreorg/core": ["./packages/core/src/index.ts"],
      "@sreorg/core/*": ["./packages/core/src/*"],
      "@sreorg/tax-india": ["./packages/tax-india/src/index.ts"],
      "@sreorg/tax-india/*": ["./packages/tax-india/src/*"],
      "@sreorg/growth": ["./packages/growth/src/index.ts"],
      "@sreorg/growth/*": ["./packages/growth/src/*"],
      "@sreorg/ui": ["./packages/ui/src/index.ts"],
      "@sreorg/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "apps/*/.next/types/**/*.ts"],
  "exclude": ["node_modules", "**/.next"]
}
