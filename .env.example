# ---- Core ----
APP_URL=https://example.com
AUTH_SECRET=            # openssl rand -hex 32

# ---- Database (Neon free tier) ----
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Razorpay (INR -> your Indian bank account) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO_MONTHLY=      # created in Razorpay dashboard, INR 399/mo
RAZORPAY_PLAN_ID_PRO_YEARLY=       # INR 3990/yr

# ---- Email (Resend free tier: 3k/mo) ----
RESEND_API_KEY=
EMAIL_FROM="Invoices <billing@example.com>"
OPERATOR_EMAIL=

# ---- Growth engine ----
ANTHROPIC_API_KEY=
