# Copy to .env and fill in. .env is gitignored - keep it that way.
# In GitHub Actions these live in Settings -> Secrets -> Actions instead.

# --- Razorpay (Dashboard -> Settings -> API Keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. Must match the value there exactly.
RAZORPAY_WEBHOOK_SECRET=

# --- Delivery email ---
# A dedicated sending address, not a personal inbox. If using Gmail this must
# be an App Password with 2FA on, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Where buyers download what they bought. Any static host works.
DELIVERY_BASE_URL=https://example.com/deliverables

# Optional: override the SQLite location.
# REVENUE_DB=data/revenue.db
