# ---- Shared across every product ----
APP_URL=https://example.com          # per-deployment; each app sets its own
AUTH_SECRET=                          # openssl rand -hex 32
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # one Neon database for the portfolio

# ---- Razorpay (INR -> your Indian bank account) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# One Razorpay plan per row, created in the dashboard. The product registry in
# packages/core/src/products.ts maps each plan code to the variable it reads.
RZP_PLAN_INVOICING_MONTHLY=      # INR 399/month
RZP_PLAN_INVOICING_YEARLY=       # INR 3,990/year
RZP_PLAN_PAYROLL_MONTHLY=        # INR 499/month
RZP_PLAN_PAYROLL_YEARLY=         # INR 4,990/year
RZP_PLAN_COMPLIANCE_MONTHLY=     # INR 199/month
RZP_PLAN_COMPLIANCE_YEARLY=      # INR 1,990/year

# ---- Email (Resend free tier: 3k/month across all products) ----
RESEND_API_KEY=
EMAIL_FROM="Notifications <hello@example.com>"
OPERATOR_EMAIL=                  # where the weekly portfolio report goes

# ---- Growth engine ----
ANTHROPIC_API_KEY=
