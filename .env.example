# ParentAI configuration. Copy to .env and fill in as needed.
# The system runs fully with LOCAL/MOCK providers using only the defaults —
# set cloud variables only to enable those providers.

# --- General ---
PARENTAI_ENVIRONMENT=local
PARENTAI_LOG_LEVEL=INFO
PARENTAI_JSON_LOGS=true

# --- Security ---
# MUST be changed in production (>= 32 bytes).
PARENTAI_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
PARENTAI_SPEAKER_CONFIDENCE_THRESHOLD=0.75
PARENTAI_RATE_LIMIT_PER_MINUTE=60

# --- Provider selection ---
# wakeword: porcupine | keyword
PARENTAI_WAKEWORD_PROVIDER=keyword
# stt: whisper | mock
PARENTAI_STT_PROVIDER=mock
# speaker: azure | elevenlabs | local_ml | mock
# 'mock' works out of the box (text clients supply the verified speaker).
# 'local_ml'/'azure'/'elevenlabs' require voice enrollment and/or cloud keys.
PARENTAI_SPEAKER_PROVIDER=mock
# llm: openai | mock
PARENTAI_LLM_PROVIDER=mock

# --- Wake word (Porcupine) ---
PARENTAI_PORCUPINE_ACCESS_KEY=
PARENTAI_WAKE_WORDS=hey parentai,hey jarvis

# --- Speaker verification (cloud) ---
PARENTAI_AZURE_SPEECH_KEY=
PARENTAI_AZURE_SPEECH_REGION=
PARENTAI_ELEVENLABS_API_KEY=

# --- LLM (OpenAI Responses API) ---
PARENTAI_OPENAI_API_KEY=
PARENTAI_OPENAI_MODEL=gpt-4o

# --- Smart home ---
PARENTAI_HOME_ASSISTANT_URL=
PARENTAI_HOME_ASSISTANT_TOKEN=
PARENTAI_MQTT_HOST=
PARENTAI_HUE_BRIDGE_IP=
PARENTAI_HUE_USERNAME=
PARENTAI_AWS_IOT_ENDPOINT=

# --- Data stores ---
PARENTAI_DATABASE_URL=sqlite+aiosqlite:///./data/parentai.db
PARENTAI_REDIS_URL=redis://localhost:6379/0

# --- Observability ---
PARENTAI_METRICS_ENABLED=true
PARENTAI_OTEL_EXPORTER_ENDPOINT=
